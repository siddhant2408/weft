{
  "manifest_version": 3,
  "name": "Margin",
  "version": "0.2.2",
  "description": "Comment threads on anything you read, where the replies come from AI.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "unlimitedStorage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "settings.js",
        "vendor/Readability.js",
        "vendor/marked.min.js",
        "vendor/purify.min.js",
        "anchor.js",
        "notes.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Margin: open threads"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://openrouter.ai/*",
    "https://api.openai.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
